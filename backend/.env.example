PORT=5000
NODE_ENV=development

# PayPal Sandbox REST API Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# OpenAI API Key (For AI Payment Failure Analysis & Intelligent Recovery)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_FILE=./data/transactions.db
